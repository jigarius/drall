#!/usr/bin/env php
<?php

/**
 * @file
 * Drall entrypoint.
 */

if (php_sapi_name() !== 'cli') exit;

foreach ([
  // Regular installation.
  __DIR__ . '/../../../autoload.php',
  // Development environment.
  __DIR__ . '/../vendor/autoload.php',
] as $candidate) {
  if (is_file($candidate)) {
    require_once $candidate;
    break;
  }

  unset($candidate);
}

use Drall\Drall;

$drall = new Drall();
$drall->setAutoExit(TRUE);
$drall->run();
